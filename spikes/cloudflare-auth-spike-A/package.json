{
  "name": "aria-cloudflare-auth-spike-a",
  "version": "0.1.0",
  "private": true,
  "description": "Aria Track B Spike — DIY phone-OTP auth on Cloudflare Workers + D1 + Plivo Verify",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply aria_auth --local",
    "db:migrate:remote": "wrangler d1 migrations apply aria_auth --remote",
    "db:seed:local": "wrangler d1 execute aria_auth --local --file=./migrations/seed_signing_key.sql",
    "test:e2e": "node test/e2e.mjs",
    "keygen": "node test/keygen.mjs",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250601.0",
    "typescript": "^5.6.0",
    "wrangler": "^4.95.0"
  }
}
