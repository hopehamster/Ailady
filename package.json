{
  "name": "aria-web-root",
  "private": true,
  "packageManager": "pnpm@10.15.1",
  "scripts": {
    "typecheck": "pnpm -r --if-present typecheck",
    "build": "pnpm -r --if-present build",
    "test": "pnpm -r --if-present test",
    "dev:worker": "pnpm -C apps/worker dev",
    "dev:web": "pnpm -C apps/web dev",
    "test:e2e": "pnpm -C apps/web test:e2e",
    "test:e2e:ci": "pnpm -C apps/web test:e2e:ci",
    "test:security": "pnpm -C packages/aria-core test:security",
    "security:gate": "pnpm -C packages/aria-core test:security && pnpm -C apps/web test:e2e:security",
    "security:volley": "bash scripts/security/run-volley.sh"
  },
  "devDependencies": {
    "@types/node-fetch": "^2.6.13",
    "typescript": "^5.6.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild", "workerd", "sharp"]
  }
}
