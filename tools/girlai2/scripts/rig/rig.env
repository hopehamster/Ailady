# Aria hardware rig — environment for the OnePlus 8T testing device.
# Source this before running rig scripts:  source ./rig.env
# All paths assume Windows + Git Bash.

export ADB="/c/Users/Owner/AppData/Local/Android/Sdk/platform-tools/adb.exe"
export APPIUM_BIN="/c/Users/Owner/AppData/Roaming/npm/appium.cmd"
export NODE_DIR="/c/Program Files/nodejs"

# Add Node + npm-global to PATH so Appium can spawn node correctly.
case ":$PATH:" in
  *":$NODE_DIR:"*) ;;
  *) export PATH="$NODE_DIR:/c/Users/Owner/AppData/Roaming/npm:$PATH" ;;
esac

# Locked device identity. Re-source if the OnePlus changes.
export DEVICE_SERIAL="70578ba3"
export DEVICE_MODEL="OnePlus 8T (IN2017)"
export ANDROID_VERSION="13"

# Output dir for screenshots + logs captured during verification.
export RIG_OUT="/c/Users/Owner/Documents/aria-rig"
mkdir -p "$RIG_OUT"
