### Create Callable Functions with TypeScript

Source: https://context7.com/firebase/firebase-functions/llms.txt

Implements a callable function using `firebase-functions/v2/https.onCall` that client applications can invoke directly. It includes authentication checks, argument validation, and returns structured data. Requires Firebase SDK and `@google-cloud/functions-framework`.

```typescript
import { onCall, HttpsError } from "firebase-functions/v2/https";
import * as logger from "firebase-functions/logger";

interface UserProfileData {
  displayName: string;
  bio: string;
}

export const updateProfile = onCall<UserProfileData>({
  region: "us-west1",
  enforceAppCheck: true,
  cors: ["https://example.com"]
}, async (request) => {
  logger.info("Callable function invoked", {
    uid: request.auth?.uid,
    data: request.data
  });

  if (!request.auth) {
    throw new HttpsError("unauthenticated", "User must be authenticated");
  }

  const { displayName, bio } = request.data;

  if (!displayName || displayName.length < 3) {
    throw new HttpsError("invalid-argument", "Display name must be at least 3 characters");
  }

  // Process the update (e.g., write to Firestore)
  return {
    success: true,
    uid: request.auth.uid,
    updatedAt: new Date().toISOString()
  };
});
```

