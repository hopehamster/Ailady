# Cloudflare Pages response headers for the deployed web app (PROD only — Vite dev
# does not serve this, so HMR is unaffected). Audit 2026-06-22 F3/F5.
#
# F3 CLOSED (#8, 2026-07-04): three + TalkingHead are now SELF-HOSTED under
# /vendor/ (immutable npm three@0.180.0 + SHA-pinned TalkingHead 67a210b), so
# script-src drops the jsDelivr CDN entirely and replaces 'unsafe-inline' with
# the ONE hash of the inline <importmap> (importmaps must be inline). Recompute
# the hash when the importmap changes:
#   node -e "const m=require('fs').readFileSync('dist/index.html','utf8').match(/<script type=\"importmap\">([\s\S]*?)<\/script>/);console.log('sha256-'+require('crypto').createHash('sha256').update(m[1]).digest('base64'))"
# connect-src keeps https:/wss: for the LiveAvatar (LiveKit) streaming path.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'sha256-nAG3xy0rRET2ecuPDHRx6qjQE+p+98x1xfv8G0NqT2c=' https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' https: wss:; frame-src https://challenges.cloudflare.com; object-src 'none'; base-uri 'self'; frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  X-Frame-Options: DENY
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin
  Permissions-Policy: camera=(), geolocation=(), payment=(), usb=(), microphone=(self)
