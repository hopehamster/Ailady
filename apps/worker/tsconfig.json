{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "types": ["@cloudflare/workers-types"],
    "noEmit": true,
    // The Worker imports aria-core SOURCE, so its tsc re-checks aria-core's files.
    // aria-core relaxed noUncheckedIndexedAccess for the initial brain port (pass-6
    // call, to tighten tier-by-tier); match it here so the consumer doesn't re-impose
    // the strict flag on un-hardened ported source. Re-enable when aria-core hardens.
    "noUncheckedIndexedAccess": false
  },
  "include": ["src"]
}
